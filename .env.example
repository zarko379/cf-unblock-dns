# Credenciales SSH del LXC con Pi-hole + Unbound, para deploy.py.
# Copia este fichero a .env (que está en .gitignore) y rellénalo.
# deploy.py lo lee y nunca muestra sus valores.

# IP o nombre del LXC
SSH_HOST=
SSH_PORT=22
# Usuario SSH. Si no es root, deploy.py usa sudo.
SSH_USER=root

# Autenticación: rellena SSH_PASSWORD, o SSH_KEY_FILE con la ruta de la clave privada.
SSH_PASSWORD=
SSH_KEY_FILE=
SSH_KEY_PASSPHRASE=

# Solo si SSH_USER no es root y sudo pide una contraseña distinta de SSH_PASSWORD.
SUDO_PASSWORD=

# Opcional: huella SHA256 de la clave del host (en el LXC:
#   ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub). Vacía: se confía en la
# primera conexión y la huella queda guardada en .ssh_known_hosts.
SSH_HOST_KEY_SHA256=
